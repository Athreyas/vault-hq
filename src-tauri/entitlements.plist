<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Entitlements for the signed, hardened-runtime build (scripts/release.sh).
  Not sandboxed: Vault HQ reads and writes the vault folders the user picks, anywhere.
  network.client lets it reach the local model server (Ollama on this Mac or the LAN).
-->
<plist version="1.0">
<dict>
  <key>com.apple.security.network.client</key>
  <true/>
</dict>
</plist>
