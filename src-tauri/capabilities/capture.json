{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "capture",
  "description": "The quick-capture window: capture, close itself, read the theme, and draft then add a task (⌘Enter).",
  "windows": [
    "capture"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-capture",
    "allow-capture-hide",
    "allow-settings-get",
    "allow-action-draft",
    "allow-action-add"
  ]
}
