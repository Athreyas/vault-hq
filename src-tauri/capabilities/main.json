{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "The main window: every HQ command and event, nothing else (no shell, fs or plugin APIs).",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-app-status",
    "allow-settings-get",
    "allow-settings-update",
    "allow-reveal",
    "allow-vaults-list",
    "allow-vault-add",
    "allow-vault-create",
    "allow-vault-remove",
    "allow-vault-set-primary",
    "allow-vault-candidates",
    "allow-notes-list",
    "allow-note-get",
    "allow-note-source",
    "allow-note-save",
    "allow-note-create",
    "allow-note-move",
    "allow-note-archive",
    "allow-templates-list",
    "allow-capture",
    "allow-home",
    "allow-days",
    "allow-needs",
    "allow-needs-decide",
    "allow-inbox",
    "allow-inbox-archive",
    "allow-tasks-query",
    "allow-task-add",
    "allow-task-update",
    "allow-task-done",
    "allow-task-cancel",
    "allow-task-delete",
    "allow-task-annotate",
    "allow-task-start",
    "allow-tasks-stats",
    "allow-tasks-import-taskwarrior",
    "allow-search",
    "allow-ask-start",
    "allow-ask-cancel",
    "allow-conversations-list",
    "allow-conversation-get",
    "allow-ollama-status",
    "allow-ollama-recommend",
    "allow-browsers-detect",
    "allow-browser-allow",
    "allow-bookmarks-import",
    "allow-bookmarks-query",
    "allow-bookmark-add",
    "allow-bookmarks-enrich",
    "allow-memories",
    "allow-memory-dismiss",
    "allow-onboarding-state",
    "allow-onboarding-set-step",
    "allow-agents-catalog",
    "allow-agent-prompt",
    "allow-agent-config-preview",
    "allow-agent-config-apply",
    "allow-import-analyze",
    "allow-import-apply",
    "allow-widgets-layout-get",
    "allow-widgets-layout-set",
    "allow-widget-data",
    "allow-capture-open",
    "allow-capture-hide"
  ]
}
